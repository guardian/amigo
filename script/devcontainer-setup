#!/usr/bin/env bash

set -euo pipefail

export AWS_PROFILE=deployTools
export AWS_REGION=eu-west-1

ssm() { aws ssm get-parameter --name "$1" --query Parameter.Value --output text; }

BUCKET=$(ssm /CODE/deploy/amigo/aws.distributionBucket)
CERT_PATH=$(ssm /DEV/deploy/amigo/auth.google.serviceAccountCertPath)
CERT_DIR=$(dirname "$CERT_PATH")
SYNCED_CERT="$CERT_DIR/amigo-service-account-cert.json"

mkdir -p "$CERT_DIR"
aws s3 sync "s3://$BUCKET/deploy/CODE/amigo/conf/" "$CERT_DIR/"
if [[ "$CERT_PATH" != "$SYNCED_CERT" ]]; then
	cp "$SYNCED_CERT" "$CERT_PATH"
fi
