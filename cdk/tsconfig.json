{
  "extends": "@guardian/tsconfig/tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "jest"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["lib/**/*", "bin/**/*"],
  "exclude": [
    "node_modules",
    "cdk.out",
    "lib/**/__snapshots__/**"
  ]
}
